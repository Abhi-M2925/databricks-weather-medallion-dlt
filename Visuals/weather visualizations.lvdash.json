{
  "datasets": [
    {
      "name": "70d25ef7",
      "displayName": "monthly_city",
      "queryLines": [
        "-- ---- Dataset: monthly_city ------------------------------------------\r\n",
        "-- Feeds: temperature line, rainfall bars, rainy days, KPI counters\r\n",
        "SELECT\r\n",
        "  city,\r\n",
        "  state,\r\n",
        "  make_date(year, month, 1) AS month_start,\r\n",
        "  year,\r\n",
        "  month,\r\n",
        "  make_date(year, 1, 1) AS year_start,\r\n",
        "  avg_temperature_max,\r\n",
        "  highest_temperature_max,\r\n",
        "  total_precipitation,\r\n",
        "  rainy_days,\r\n",
        "  is_complete_month\r\n",
        "FROM weather_medallion_dlt.gold.weather_monthly_city;"
      ]
    },
    {
      "name": "46aa53ab",
      "displayName": "yearly_city",
      "queryLines": [
        "-- ---- Dataset: yearly_city -------------------------------------------\r\n",
        "-- Complete years only, so a partial year (2026) does not look like a dry/cool year.\r\n",
        "-- Feeds: yearly trend, hottest/wettest table\r\n",
        "SELECT\r\n",
        "  city,\r\n",
        "  state,\r\n",
        "  year,\r\n",
        "  make_date(year, 1, 1) AS year_start,\r\n",
        "  avg_temperature_max,\r\n",
        "  total_precipitation,\r\n",
        "  rainy_days,\r\n",
        "  hottest_day,\r\n",
        "  hottest_day_temperature,\r\n",
        "  wettest_day,\r\n",
        "  wettest_day_precipitation,\r\n",
        "  yoy_avg_temperature_change,\r\n",
        "  yoy_total_precipitation_change\r\n",
        "FROM weather_medallion_dlt.gold.weather_yearly_city\r\n",
        "WHERE is_complete_year\r\n",
        "ORDER BY city, year;"
      ]
    },
    {
      "name": "d4e3fa72",
      "displayName": "city_month_climate",
      "queryLines": [
        "-- ---- Dataset: city_month_climate ------------------------------------\r\n",
        "-- \"Typical\" temperature and rainfall for each city and calendar month (complete months only).\r\n",
        "-- Feeds: city x month heatmap\r\n",
        "SELECT\r\n",
        "  city,\r\n",
        "  state,\r\n",
        "  month,\r\n",
        "  date_format(make_date(2000, month, 1), 'MMM') AS month_name,\r\n",
        "  ROUND(AVG(avg_temperature_max), 1) AS typical_temperature_max,\r\n",
        "  ROUND(AVG(total_precipitation), 1) AS typical_monthly_rainfall\r\n",
        "FROM weather_medallion_dlt.gold.weather_monthly_city\r\n",
        "WHERE is_complete_month\r\n",
        "GROUP BY city, state, month;"
      ]
    },
    {
      "name": "8baccea0",
      "displayName": "state_monthly",
      "queryLines": [
        "-- ---- Dataset: state_monthly -----------------------------------------\r\n",
        "-- Feeds: state comparison bars\r\n",
        "SELECT\r\n",
        "  state,\r\n",
        "  make_date(year, month, 1) AS month_start,\r\n",
        "  year,\r\n",
        "  month,\r\n",
        "  cities_in_state,\r\n",
        "  avg_temperature_max,\r\n",
        "  avg_city_precipitation_total,\r\n",
        "  avg_city_rainy_days\r\n",
        "FROM weather_medallion_dlt.gold.weather_monthly_state\r\n",
        "WHERE is_complete_month;"
      ]
    },
    {
      "name": "5531c439",
      "displayName": "anomalies",
      "queryLines": [
        "-- ---- Dataset: anomalies ---------------------------------------------\r\n",
        "-- Complete months only (incomplete months have null anomalies).\r\n",
        "-- Feeds: temperature and rainfall anomaly bars\r\n",
        "SELECT\r\n",
        "  city,\r\n",
        "  state,\r\n",
        "  make_date(year, month, 1) AS month_start,\r\n",
        "  year,\r\n",
        "  month,\r\n",
        "  make_date(year, 1, 1) AS year_start,\r\n",
        "  avg_temperature_max,\r\n",
        "  baseline_avg_temperature_max,\r\n",
        "  temperature_anomaly,\r\n",
        "  total_precipitation,\r\n",
        "  baseline_total_precipitation,\r\n",
        "  precipitation_anomaly\r\n",
        "FROM weather_medallion_dlt.gold.weather_monthly_anomaly\r\n",
        "WHERE is_complete_month;"
      ],
      "columns": [
        {
          "displayName": "temperature_anomaly_direction",
          "description": "Labels each month's temperature anomaly as above (warmer) or below (cooler) the baseline; drives red/blue bar coloring.",
          "expression": "CASE WHEN `temperature_anomaly` >= 0 THEN 'Warmer than usual' ELSE 'Cooler than usual' END"
        },
        {
          "displayName": "precipitation_anomaly_direction",
          "description": "Labels each month's rainfall anomaly as above (wetter) or below (drier) the baseline; drives red/blue bar coloring.",
          "expression": "CASE WHEN `precipitation_anomaly` >= 0 THEN 'Wetter than usual' ELSE 'Drier than usual' END"
        }
      ]
    },
    {
      "name": "250728cf",
      "displayName": "seasons",
      "queryLines": [
        "-- ---- Dataset: seasons -----------------------------------------------\r\n",
        "-- Season summary straight from silver (gold has no season grain).\r\n",
        "-- Feeds: season comparison\r\n",
        "SELECT\r\n",
        "  d.city,\r\n",
        "  d.state,\r\n",
        "  w.year,\r\n",
        "  w.season,\r\n",
        "  ROUND(AVG(w.temperature_max), 1) AS avg_temperature_max,\r\n",
        "  ROUND(SUM(w.precipitation), 1) AS total_precipitation,\r\n",
        "  SUM(CASE WHEN w.is_rainy_day THEN 1 ELSE 0 END) AS rainy_days,\r\n",
        "  COUNT(*) AS days_with_data\r\n",
        "FROM weather_medallion_dlt.silver.weather_daily w\r\n",
        "JOIN weather_medallion_dlt.silver.dim_location d USING (location_id)\r\n",
        "GROUP BY d.city, d.state, w.year, w.season;"
      ]
    }
  ],
